OPENAI_API_KEY=
# Kept configurable so an operator can change it without changing source code.
OPENAI_IMAGE_MODEL=gpt-image-1

# Instagram API credentials. Never commit real values. The daily Reel runner
# requires a Facebook Login token; carousel runners also support Instagram Login.
INSTAGRAM_USER_ID=
# Instagram Login token used by carousel runners.
INSTAGRAM_ACCESS_TOKEN=
# Facebook Login tokens used only by run_daily_reel.py.
INSTAGRAM_FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_FACEBOOK_USER_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v26.0
# Public HTTPS directory containing slide-1.jpg through slide-6.jpg.
INSTAGRAM_IMAGE_BASE_URL=

# The full weekly run deploys to a dedicated secondary Hosting site so it
# cannot replace the original app's Firebase Hosting release.
FIREBASE_PROJECT_ID=
FIREBASE_HOSTING_SITE=
